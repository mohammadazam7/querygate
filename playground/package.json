{
  "name": "querygate-playground",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Try querygate in the browser: the real Python package runs in the page through Pyodide, so a policy and a query can be edited and checked live.",
  "scripts": {
    "prepare-py": "bash scripts/prepare-py.sh",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/archivo": "5.2.8",
    "@fontsource/jetbrains-mono": "5.2.8",
    "pyodide": "0.27.7"
  },
  "devDependencies": {
    "@types/node": "22.10.1",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.5"
  }
}
